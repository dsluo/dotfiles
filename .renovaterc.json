{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update npm packages listed in pi agent settings.json",
      "managerFilePatterns": [
        "/dot_pi/agent/settings\\.json$/"
      ],
      "matchStrings": [
        "\"npm:(?<depName>(?:@[^/\"]+/)?[^@\"]+)@(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update git tags pinned in mise [bootstrap.repos]",
      "managerFilePatterns": [
        "/dot_config/mise/config\\.toml$/"
      ],
      "matchStrings": [
        "url = \"https://github\\.com/(?<depName>[^/\"]+/[^/\"]+?)(?:\\.git)?\", ref = \"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
