{
  "mcpServers": {
    "search": {
      "url": "{{ onepasswordRead "op://chezmoi/all/searxng-mcp endpoint" }}",
      "directTools": [
        "searxng_web_search",
        "web_url_read"
      ]
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp",
      "auth": "bearer",
      "bearerToken": "{{ onepasswordRead "op://Private/GitHub/pat" }}",
      "headers": {
        "X-MCP-Toolsets": "actions,discussions,gists,git,issues,labels,orgs,projects,pull_requests,repos,security_advisories",
        "X-MCP-Readonly": "true"
      },
      "directTools": [
        "get_commit",
        "get_file_contents",
        "get_latest_release",
        "get_repository_tree",
        "issue_read",
        "list_branches",
        "list_commits",
        "list_issues",
        "list_pull_requests",
        "list_releases",
        "list_tags",
        "pull_request_read",
        "search_code",
        "search_issues",
        "search_pull_requests",
        "search_repositories"
      ]
    }
  }
}
